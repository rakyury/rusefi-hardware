(version 1)
(rule "Power clearance" (condition "A.NetName == 'VBAT_MAIN_FUSED' || A.NetName == 'VBAT_LOGIC_PROTECTED' || A.NetName == 'VBAT_GDI_A' || A.NetName == 'VBAT_GDI_B' || A.NetName == 'VBAT_DBW_FUSED' || A.NetName == 'VBAT_EWG_FUSED' || A.NetName == 'LP5_BOOT' || A.NetName == 'LP5_SW' || A.NetName == 'PTA_+Batt_filtered' || A.NetName == 'PTB_+Batt_filtered'") (constraint clearance (min 0.3mm)))
(rule "GDI high voltage clearance" (condition "A.NetName == 'Net-(Q203-G)' || A.NetName == 'Net-(Q203-S)' || A.NetName == 'Net-(Q204-G)' || A.NetName == 'Net-(Q205-G)' || A.NetName == 'Net-(Q205-S)' || A.NetName == 'Net-(Q206-G)' || A.NetName == 'Net-(Q211-G)' || A.NetName == 'Net-(Q303-G)' || A.NetName == 'Net-(Q303-S)' || A.NetName == 'Net-(Q304-G)' || A.NetName == 'Net-(Q305-G)' || A.NetName == 'Net-(Q305-S)' || A.NetName == 'Net-(Q306-G)' || A.NetName == 'Net-(Q311-G)' || A.NetName == 'Net-(U201-B_HS1)' || A.NetName == 'Net-(U201-B_HS2)' || A.NetName == 'Net-(U201-B_HS3)' || A.NetName == 'Net-(U201-B_HS4)' || A.NetName == 'Net-(U201-B_HS5)' || A.NetName == 'Net-(U201-D_LS6)' || A.NetName == 'Net-(U201-G_HS1)' || A.NetName == 'Net-(U201-G_HS2)' || A.NetName == 'Net-(U201-G_HS3)' || A.NetName == 'Net-(U201-G_HS4)' || A.NetName == 'Net-(U201-G_HS5)' || A.NetName == 'Net-(U301-B_HS1)' || A.NetName == 'Net-(U301-B_HS2)' || A.NetName == 'Net-(U301-B_HS3)' || A.NetName == 'Net-(U301-B_HS4)' || A.NetName == 'Net-(U301-B_HS5)' || A.NetName == 'Net-(U301-D_LS6)' || A.NetName == 'Net-(U301-G_HS1)' || A.NetName == 'Net-(U301-G_HS2)' || A.NetName == 'Net-(U301-G_HS3)' || A.NetName == 'Net-(U301-G_HS4)' || A.NetName == 'Net-(U301-G_HS5)' || A.NetName == 'PTA_H1' || A.NetName == 'PTA_H3' || A.NetName == 'PTA_H5PUMP' || A.NetName == 'PTA_L1' || A.NetName == 'PTA_L2' || A.NetName == 'PTA_L3' || A.NetName == 'PTA_L4' || A.NetName == 'PTA_L5' || A.NetName == 'PTA_L6' || A.NetName == 'PTA_L6PUMP' || A.NetName == 'PTA_VBOOST' || A.NetName == 'PTA_Vdrive_coil' || A.NetName == 'PTA_Vdrive_shunt' || A.NetName == 'PTB_H1' || A.NetName == 'PTB_H3' || A.NetName == 'PTB_H5PUMP' || A.NetName == 'PTB_L1' || A.NetName == 'PTB_L2' || A.NetName == 'PTB_L3' || A.NetName == 'PTB_L4' || A.NetName == 'PTB_L5' || A.NetName == 'PTB_L6' || A.NetName == 'PTB_L6PUMP' || A.NetName == 'PTB_VBOOST' || A.NetName == 'PTB_Vdrive_coil' || A.NetName == 'PTB_Vdrive_shunt'") (constraint clearance (min 0.6mm)))
(rule "Ignition preliminary isolation target - qualification pending" (condition "A.NetName == 'HARNESS_IGN1' || A.NetName == 'HARNESS_IGN2' || A.NetName == 'HARNESS_IGN3' || A.NetName == 'HARNESS_IGN4' || A.NetName == 'HARNESS_IGN5' || A.NetName == 'HARNESS_IGN6' || A.NetName == 'HARNESS_IGN7' || A.NetName == 'HARNESS_IGN8'") (constraint clearance (min 2.5mm)))
