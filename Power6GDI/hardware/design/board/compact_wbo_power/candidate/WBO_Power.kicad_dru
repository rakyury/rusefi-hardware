(version 1)
(rule "Power clearance" (condition "A.NetName == 'VBAT_MAIN_FUSED' || A.NetName == 'VBAT_LOGIC_PROTECTED' || A.NetName == 'VBAT_GDI_A' || A.NetName == 'VBAT_GDI_B' || A.NetName == 'VBAT_DBW_FUSED' || A.NetName == 'VBAT_EWG_FUSED' || A.NetName == 'DBW_MOTOR_A' || A.NetName == 'DBW_MOTOR_B' || A.NetName == 'EWG_MOTOR_A' || A.NetName == 'EWG_MOTOR_B' || A.NetName == 'GDI_A_CAP' || A.NetName == 'GDI_A_DGATE' || A.NetName == 'GDI_A_HGATE' || A.NetName == 'GDI_A_MID' || A.NetName == 'GDI_A_SLEW' || A.NetName == 'GDI_A_SW' || A.NetName == 'GDI_B_CAP' || A.NetName == 'GDI_B_DGATE' || A.NetName == 'GDI_B_HGATE' || A.NetName == 'GDI_B_MID' || A.NetName == 'GDI_B_SLEW' || A.NetName == 'GDI_B_SW' || A.NetName == 'LP5_BOOT' || A.NetName == 'LP5_SW' || A.NetName == 'MOTOR13_CAP' || A.NetName == 'MOTOR13_DGATE' || A.NetName == 'MOTOR13_HGATE' || A.NetName == 'MOTOR13_MID' || A.NetName == 'MOTOR13_SLEW' || A.NetName == 'MOTOR13_SW' || A.NetName == 'MOTOR13_VS' || A.NetName == 'MOTOR24_CAP' || A.NetName == 'MOTOR24_DGATE' || A.NetName == 'MOTOR24_HGATE' || A.NetName == 'MOTOR24_MID' || A.NetName == 'MOTOR24_SLEW' || A.NetName == 'MOTOR24_SW' || A.NetName == 'MOTOR24_VS' || A.NetName == 'PTA_+Batt_filtered' || A.NetName == 'PTB_+Batt_filtered' || A.NetName == 'VBAT_DBW_FUSED' || A.NetName == 'VBAT_EWG_FUSED' || A.NetName == 'VBAT_GDI_A' || A.NetName == 'VBAT_GDI_A_FUSED' || A.NetName == 'VBAT_GDI_B' || A.NetName == 'VBAT_GDI_B_FUSED' || A.NetName == 'unconnected-(U5001-EP_FLOAT-Pad13)' || A.NetName == 'unconnected-(U5051-EP_FLOAT-Pad13)' || A.NetName == 'unconnected-(U6200-EP_FLOAT-Pad13)' || A.NetName == 'unconnected-(U6250-EP_FLOAT-Pad13)'") (constraint clearance (min 0.3mm)))
(rule "GDI high voltage clearance" (condition "A.NetName == 'Net-(Q203-G)' || A.NetName == 'Net-(Q203-S)' || A.NetName == 'Net-(Q204-G)' || A.NetName == 'Net-(Q205-G)' || A.NetName == 'Net-(Q205-S)' || A.NetName == 'Net-(Q206-G)' || A.NetName == 'Net-(Q211-G)' || A.NetName == 'Net-(Q303-G)' || A.NetName == 'Net-(Q303-S)' || A.NetName == 'Net-(Q304-G)' || A.NetName == 'Net-(Q305-G)' || A.NetName == 'Net-(Q305-S)' || A.NetName == 'Net-(Q306-G)' || A.NetName == 'Net-(Q311-G)' || A.NetName == 'Net-(U201-B_HS1)' || A.NetName == 'Net-(U201-B_HS2)' || A.NetName == 'Net-(U201-B_HS3)' || A.NetName == 'Net-(U201-B_HS4)' || A.NetName == 'Net-(U201-B_HS5)' || A.NetName == 'Net-(U201-D_LS6)' || A.NetName == 'Net-(U201-G_HS1)' || A.NetName == 'Net-(U201-G_HS2)' || A.NetName == 'Net-(U201-G_HS3)' || A.NetName == 'Net-(U201-G_HS4)' || A.NetName == 'Net-(U201-G_HS5)' || A.NetName == 'Net-(U301-B_HS1)' || A.NetName == 'Net-(U301-B_HS2)' || A.NetName == 'Net-(U301-B_HS3)' || A.NetName == 'Net-(U301-B_HS4)' || A.NetName == 'Net-(U301-B_HS5)' || A.NetName == 'Net-(U301-D_LS6)' || A.NetName == 'Net-(U301-G_HS1)' || A.NetName == 'Net-(U301-G_HS2)' || A.NetName == 'Net-(U301-G_HS3)' || A.NetName == 'Net-(U301-G_HS4)' || A.NetName == 'Net-(U301-G_HS5)' || A.NetName == 'PTA_H1' || A.NetName == 'PTA_H3' || A.NetName == 'PTA_H5PUMP' || A.NetName == 'PTA_L1' || A.NetName == 'PTA_L2' || A.NetName == 'PTA_L3' || A.NetName == 'PTA_L5' || A.NetName == 'PTA_L6' || A.NetName == 'PTA_L6PUMP' || A.NetName == 'PTA_VBOOST' || A.NetName == 'PTA_Vdrive_coil' || A.NetName == 'PTA_Vdrive_shunt' || A.NetName == 'PTB_H1' || A.NetName == 'PTB_H3' || A.NetName == 'PTB_H5PUMP' || A.NetName == 'PTB_L1' || A.NetName == 'PTB_L2' || A.NetName == 'PTB_L3' || A.NetName == 'PTB_L5' || A.NetName == 'PTB_L6' || A.NetName == 'PTB_L6PUMP' || A.NetName == 'PTB_VBOOST' || A.NetName == 'PTB_Vdrive_coil' || A.NetName == 'PTB_Vdrive_shunt' || A.NetName == 'unconnected-(U201-D_LS4-Pad35)' || A.NetName == 'unconnected-(U301-D_LS4-Pad35)'") (constraint clearance (min 0.6mm)))
(rule "Ignition preliminary isolation target - qualification pending" (condition "A.NetName == 'HARNESS_IGN1' || A.NetName == 'HARNESS_IGN2' || A.NetName == 'HARNESS_IGN3' || A.NetName == 'HARNESS_IGN4' || A.NetName == 'HARNESS_IGN5' || A.NetName == 'HARNESS_IGN6'") (constraint clearance (min 2.5mm)))
(rule "TI RNP0030 land pair 5-6" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U5200') && B.memberOfFootprint('U5200') && ((A.Pad_Number == '5' && B.Pad_Number == '6') || (A.Pad_Number == '6' && B.Pad_Number == '5'))") (constraint clearance (min 0.25mm)))
(rule "TI RNP0030 land pair 6-7" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U5200') && B.memberOfFootprint('U5200') && ((A.Pad_Number == '6' && B.Pad_Number == '7') || (A.Pad_Number == '7' && B.Pad_Number == '6'))") (constraint clearance (min 0.25mm)))
(rule "TI RNP0030 land pair 19-20" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U5200') && B.memberOfFootprint('U5200') && ((A.Pad_Number == '19' && B.Pad_Number == '20') || (A.Pad_Number == '20' && B.Pad_Number == '19'))") (constraint clearance (min 0.25mm)))
(rule "TI RNP0030 land pair 22-23" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U5200') && B.memberOfFootprint('U5200') && ((A.Pad_Number == '22' && B.Pad_Number == '23') || (A.Pad_Number == '23' && B.Pad_Number == '22'))") (constraint clearance (min 0.25mm)))

