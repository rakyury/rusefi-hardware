  "observed_reference_firmware": [
    {
      "id": "shared_control",
      "finding": "EFI_PT2001_CHIPS>1 uses shared PB4 DRVEN/PB5 reset; per-instance setters become no-ops.",
      "evidence": [
        {
          "source": "gdi_driver",
          "locator": "setResetB and setDriveEN"
        },
        {
          "source": "gdi_main",
          "locator": "initPt2001Interface and main multi-chip branches"
        }
      ]
    },
    {
      "id": "shared_diagnostic",
      "finding": "readFlag0 always reads PB7 for every instance; unexpected flag checking disabled.",
      "evidence": [
        {
          "source": "gdi_driver",
          "locator": "readFlag0 and errorOnUnexpectedFlag"
        }
      ]
    },
    {
      "id": "constant_supply",
      "finding": "getVbatt returns constant 12; not a measured supply qualification.",
      "evidence": [
        {
          "source": "gdi_driver",
          "locator": "getVbatt"
        }
      ]
    },
    {
      "id": "automatic_restart",
      "finding": "Worker calls restart on faults each approximately 100ms loop; no explicit re-arm gate in this code.",
      "evidence": [
        {
          "source": "gdi_main",
          "locator": "PtWorkerThread"
        }
      ]
    },
    {
      "id": "default_variant",
      "finding": "EFI_PT2001_CHIPS defaults 1 and EFI_BOARD_E92 defaults 1; build-time variation must be pinned.",
      "evidence": [
        {
          "source": "gdi_features",
          "locator": "default macros"
        }
      ]
    },
    {
      "id": "symbol_migration",
      "finding": "Legacy MC33816 symbol labels pin20 VCC2P5 and MISO/FLAG as input; PT2001 device definitions differ.",
      "evidence": [
        {
          "source": "gdi_pcb",
          "locator": "U1 pads 10,15,20"
        },
        {
          "source": "nxp_sds",
          "locator": "Table 2 pp5-6"
        }
      ]
    }
  ],
  "blockers": [
    {
      "id": "BOM_VARIANT",
