      "evidence_required": "Obtain authorized full PT2001 datasheet/safety manual and AN4849/AN12336; public downloads redirected to NXP login."
    },
    {
      "id": "SOURCE_LICENSE",
      "evidence_required": "Confirm applicable license/permission for schematic, PCB and bespoke firmware before reuse; Apache headers in ChibiOS files do not cover the entire design."
    },
    {
      "id": "F7_MAPPING",
      "evidence_required": "Review exact F7 package/pinmux, independent stage signals, timing resources and reset states."
    },
    {
      "id": "MICROCODE_POLARITY",
      "evidence_required": "Pin device microcode/register images, HPFP mapping, input inversions and flag semantics; verify all active and safe levels."
    },
    {
      "id": "ELECTRICAL_STAGE",
      "evidence_required": "Create and review actual dual-stage circuit with independent physical inhibit, boost/sense/return/connector design."
    },
    {
      "id": "MEASUREMENTS",
      "evidence_required": "Measure startup/brownout/MCU halt, driver faults, gate disable latency, boost overshoot/discharge, injector and pump current, thermal and EMC."
    }
