# Electrical artifacts use canonical LF on every host. Binary deliverables
# remain byte-identical; report hashes explicitly state their normalization.
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_mod text eol=lf
*.kicad_sym text eol=lf
*.kicad_pro text eol=lf
*.kicad_dru text eol=lf
*.net text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.pdf -text
*.png -text
