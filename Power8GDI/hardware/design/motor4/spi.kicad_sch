(text "Mode1, MSB-first, <=1MHz initial configuration, 16 clocks per CS pulse; hold CS high >=2us between frames." (at 20 250 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ea2bfc9e-bcb5-53d9-ae13-266bbe75d48b"))
(text "Send bytes EWG,DBW. Receive previous-frame replies in the same order. SIN bit must remain0." (at 20 258 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ddbdead7-4807-5f92-bfe3-b35bed78cca3"))
