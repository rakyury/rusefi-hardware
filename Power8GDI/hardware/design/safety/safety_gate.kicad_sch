(text "ENGINEERING CANDIDATE — NOT QUALIFIED FOR ACTUATION" (at 20 15 0) (effects (font (size 2 2)) (justify left top)) (uuid "3df30a8f-edec-5a55-aa74-5c4b6b2f15c7"))
(text "3.3 V logic only. Hardware faults asynchronously clear enable; recovery requires a fresh ARM rising edge.\nMIC output isolation remains DNP. No PT2001 DRVEN connection or assumed polarity.\n64.288 ms nominal watchdog is a backup CPU monitor, NOT a coil dwell/current limiter." (at 20 23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "563e7db0-2d8a-5e82-90d9-32eaf1363815"))
