(version 1)
(rule "Power clearance" (condition "A.NetName == '+3V3' || A.NetName == '+3V3_A' || A.NetName == '+5V_CORE' || A.NetName == '+5V_GDI_A' || A.NetName == '+5V_GDI_B' || A.NetName == 'VBAT_MAIN_FUSED' || A.NetName == 'VBAT_LOGIC_PROTECTED' || A.NetName == 'VBAT_GDI_A' || A.NetName == 'VBAT_GDI_B' || A.NetName == 'VBAT_DBW_FUSED' || A.NetName == 'VBAT_EWG_FUSED'") (constraint clearance (min 0.3mm)))
(rule "GDI high voltage clearance" (condition "A.NetName == 'PTA_VBOOST' || A.NetName == 'PTA_Vdrive_coil' || A.NetName == 'PTA_Vdrive_shunt' || A.NetName == 'PTB_VBOOST' || A.NetName == 'PTB_Vdrive_coil' || A.NetName == 'PTB_Vdrive_shunt'") (constraint clearance (min 0.6mm)))
(rule "Ignition preliminary isolation target - qualification pending" (condition "A.NetName == 'HARNESS_IGN1' || A.NetName == 'HARNESS_IGN2' || A.NetName == 'HARNESS_IGN3' || A.NetName == 'HARNESS_IGN4' || A.NetName == 'HARNESS_IGN5' || A.NetName == 'HARNESS_IGN6' || A.NetName == 'HARNESS_IGN7' || A.NetName == 'HARNESS_IGN8'") (constraint clearance (min 2.5mm)))
