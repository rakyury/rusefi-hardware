(global_label "LS_SPI_MOSI" (shape bidirectional) (at 260.35 161.29 90) (effects (font (size 1.016 1.016)) (justify right bottom)) (uuid "d80af825-efb8-5a84-8c82-26f9f3e8dd8a"))
(text "Startup: all24 commands low, sixCS high, reset-release low. Stabilize 3V3/5V; hold RESN low >=10us.\nRelease reset; verify POR, keep outputs disabled, set direct-drive/no-parallel CFG bits.\nSet OUT_EN only after configuration readback and healthy watchdog; then arm hardware permission.\nMaintain communication watchdog (default50ms); 16-bit odd-parity frames; bus mode/clock changed only with allCS high.\nNo automatic fault clearing/re-enable. External watchdog is not a per-injector maximum pulse timer.\nSPI scheduling, rail sequencing, current/flyback/thermal and engine timing need hardware verification." (at 25.4 200 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d0277e08-7795-5daf-a138-af6e29ba74b5"))
(sheet_instances (path "/" (page "1"))))
